<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33A78BFA">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#121722"
                android:startColor="#201B33"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.2dp"
                android:color="#4DA78BFA" />
        </shape>
    </item>
</ripple>
