<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran d'accueil style CarPlay pour écran 1024x600 paysage.
    [ dock vertical ] [ carte (arrondie) ] [ lecteur + téléphone / date ]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- ===== Dock vertical ===== -->
    <LinearLayout
        android:layout_width="78dp"
        android:layout_height="match_parent"
        android:layout_marginRight="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="16:56"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/btnOtaUpdate"
            android:layout_width="54dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_update_badge"
            android:gravity="center"
            android:soundEffectsEnabled="false"
            android:text="@string/update_available"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout style="@style/DockSlot">

            <ImageButton
                android:id="@+id/dockNav"
                style="@style/DockTile"
                android:layout_gravity="center"
                android:background="@drawable/bg_tile_maps"
                android:contentDescription="@string/nav_title"
                android:src="@drawable/ic_nav" />
        </FrameLayout>

        <FrameLayout style="@style/DockSlot">

            <ImageButton
                android:id="@+id/dockMusic"
                style="@style/DockTile"
                android:layout_gravity="center"
                android:background="@drawable/bg_tile_music"
                android:contentDescription="@string/music_title"
                android:src="@drawable/ic_music" />
        </FrameLayout>

        <FrameLayout style="@style/DockSlot">

            <ImageButton
                android:id="@+id/dockPhone"
                style="@style/DockTile"
                android:layout_gravity="center"
                android:background="@drawable/bg_tile_phone"
                android:contentDescription="@string/phone_title"
                android:src="@drawable/ic_phone" />
        </FrameLayout>

        <FrameLayout style="@style/DockSlot">

            <ImageButton
                android:id="@+id/dockApps"
                style="@style/DockTile"
                android:layout_gravity="center"
                android:background="@drawable/bg_tile_gray"
                android:contentDescription="@string/drawer_title"
                android:src="@drawable/ic_apps" />
        </FrameLayout>

        <FrameLayout style="@style/DockSlot">

            <ImageButton
                android:id="@+id/dockCarSystem"
                style="@style/DockTile"
                android:layout_gravity="center"
                android:background="@drawable/bg_tile_gray"
                android:contentDescription="@string/stock_home_title"
                android:src="@drawable/ic_car_system" />
        </FrameLayout>

        <FrameLayout style="@style/DockSlot">

            <ImageButton
                android:id="@+id/dockSettings"
                style="@style/DockTile"
                android:layout_gravity="center"
                android:background="@drawable/bg_tile_settings"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Carte ===== -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="8dp"
        android:layout_weight="62"
        android:background="@drawable/bg_card"
        android:clipToOutline="true">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Instruction de navigation (Waze / Google Maps) -->
        <LinearLayout
            android:id="@+id/navBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="10dp"
            android:background="@drawable/bg_nav_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="14dp"
                android:gravity="center_horizontal"
                android:minWidth="64dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgNavArrow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_arrow" />

                <TextView
                    android:id="@+id/tvNavDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNavInstruction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Vitesse -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_margin="10dp"
            android:background="@drawable/bg_overlay"
            android:gravity="center_horizontal"
            android:minWidth="86dp"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/speed_none"
                android:textColor="@color/text_primary"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed_unit"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Recentrer (visible seulement si la carte a été déplacée au doigt) -->
        <ImageButton
            android:id="@+id/btnRecenter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="66dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/recenter"
            android:scaleType="center"
            android:soundEffectsEnabled="false"
            android:src="@drawable/ic_recenter"
            android:visibility="gone" />

        <!-- Rechercher une destination -->
        <LinearLayout
            android:id="@+id/btnSearchPlace"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|right"
            android:layout_margin="10dp"
            android:background="@drawable/bg_overlay_click"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="18dp"
            android:soundEffectsEnabled="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginRight="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_where_to"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Barre de navigation : arrivée · durée · distance + Waze + arrêter -->
        <LinearLayout
            android:id="@+id/navBottomBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="106dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_overlay"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNavEta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnNavWaze"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:soundEffectsEnabled="false"
                android:text="@string/open_waze"
                android:textColor="@color/accent_blue"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnNavStop"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_red"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:soundEffectsEnabled="false"
                android:text="@string/nav_stop"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Recherche de destination (par-dessus la carte) -->
        <LinearLayout
            android:id="@+id/searchPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F21C1C1E"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/etPlaceSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/nav_search_hint"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="textPostalAddress"
                        android:paddingLeft="10dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="18sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSearchClose"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_circle_gray"
                    android:contentDescription="@string/settings_close"
                    android:soundEffectsEnabled="false"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="@string/nav_recent"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ListView
                android:id="@+id/listPlaces"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none"
                android:soundEffectsEnabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMapAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="3dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="3"
            android:text="@string/map_attribution"
            android:textColor="#B3FFFFFF"
            android:textSize="9sp" />
    </FrameLayout>

    <!-- ===== Colonne droite ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="38"
        android:orientation="vertical">

        <!-- Lecteur -->
        <LinearLayout
            android:id="@+id/cardMusicPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_click"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp"
            android:soundEffectsEnabled="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgAlbumArt"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginRight="14dp"
                    android:background="@drawable/bg_art"
                    android:clipToOutline="true"
                    android:contentDescription="@string/music_title"
                    android:scaleType="center"
                    android:src="@drawable/ic_music_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMusicSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:text="@string/music_title"
                        android:textAllCaps="true"
                        android:textColor="@color/accent_pink"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTrackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:text="@string/media_idle_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvTrackArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/media_idle_artist"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnEnableMediaAccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:soundEffectsEnabled="false"
                android:text="@string/enable_media_access"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/progressTrack"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginBottom="12dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/progress_media"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_clear"
                    android:contentDescription="Précédent"
                    android:scaleType="center"
                    android:soundEffectsEnabled="false"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginLeft="22dp"
                    android:layout_marginRight="22dp"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="Lecture"
                    android:scaleType="center"
                    android:soundEffectsEnabled="false"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_clear"
                    android:contentDescription="Suivant"
                    android:scaleType="center"
                    android:soundEffectsEnabled="false"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- Téléphone + date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="8dp"
                android:layout_weight="1.25"
                android:background="@drawable/bg_card_click"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="12dp"
                android:soundEffectsEnabled="false">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/bg_tile_phone"
                    android:contentDescription="@null"
                    android:scaleType="center"
                    android:src="@drawable/ic_phone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/phone_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvPhoneSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/tap_to_assign"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="JEUDI"
                    android:textAllCaps="true"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="20 nov."
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
