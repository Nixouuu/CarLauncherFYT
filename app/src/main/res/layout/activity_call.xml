<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'appel plein écran (remplace l'écran d'appel FYT d'origine). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="horizontal"
    android:padding="24dp">

    <!-- Gauche : qui appelle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCallAvatar"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/bg_avatar"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/text_primary"
            android:textSize="54sp" />

        <TextView
            android:id="@+id/tvCallName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Appel"
            android:textColor="@color/text_primary"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvCallNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent_green"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Droite : commandes (ou clavier DTMF) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Appel entrant -->
        <LinearLayout
            android:id="@+id/panelIncoming"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnReject"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_circle_red"
                    android:contentDescription="@string/call_reject"
                    android:soundEffectsEnabled="false"
                    android:src="@drawable/ic_call_end" />

                <TextView
                    style="@style/CallLabel"
                    android:text="@string/call_reject" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnAnswer"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_circle_green"
                    android:contentDescription="@string/call_answer"
                    android:soundEffectsEnabled="false"
                    android:src="@drawable/ic_call" />

                <TextView
                    style="@style/CallLabel"
                    android:text="@string/call_answer" />
            </LinearLayout>
        </LinearLayout>

        <!-- En appel -->
        <LinearLayout
            android:id="@+id/panelActive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/callButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnCallKeypad"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_circle_gray"
                        android:contentDescription="@string/call_keypad"
                        android:soundEffectsEnabled="false"
                        android:src="@drawable/ic_dialpad" />

                    <TextView
                        style="@style/CallLabel"
                        android:text="@string/call_keypad" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="40dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnCallAudio"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_circle_gray"
                        android:contentDescription="@string/call_audio_phone"
                        android:soundEffectsEnabled="false"
                        android:src="@drawable/ic_smartphone" />

                    <TextView
                        android:id="@+id/tvCallAudio"
                        style="@style/CallLabel"
                        android:text="@string/call_audio_phone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/callKeypad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnHangUp"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_circle_red"
                android:contentDescription="@string/call_hang_up"
                android:soundEffectsEnabled="false"
                android:src="@drawable/ic_call_end" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
